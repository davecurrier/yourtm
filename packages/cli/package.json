{
  "name": "@yourtm/cli",
  "version": "0.1.0",
  "description": "YourTM CLI - Command-line tool for tag management",
  "type": "module",
  "bin": {
    "ytm": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "chokidar": "^3.5.3",
    "commander": "^11.1.0",
    "esbuild": "^0.19.8",
    "glob": "^10.3.10",
    "ora": "^8.0.1",
    "playwright": "^1.58.2",
    "prompts": "^2.4.2",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/prompts": "^2.4.9",
    "@types/ws": "^8.5.10",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "tag-manager",
    "analytics",
    "gtm",
    "cli",
    "yourtm"
  ],
  "author": "YourTM",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourtm/yourtm-cli"
  }
}
