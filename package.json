{
  "name": "yourtm-cli",
  "version": "0.1.0",
  "author": "David Currier",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "example"
  ],
  "scripts": {
    "build": "npm run build -w @yourtm/core && npm run build -w @yourtm/runtime -w @yourtm/vendors -w @yourtm/testing -w @yourtm/cli -w desktop",
    "dev": "npm run dev --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "clean": "rm -rf packages/*/dist"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "tsup": "^8.0.1",
    "vitest": "^1.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
